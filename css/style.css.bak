header {
  background-color: #0f172a;
  color: white;
  text-align: center;
  padding: 20px;
}

main {
  padding: 40px;
}

h1, h2, h3 {
  text-align: center;
}

body {
  background-color: #f7f9fc;
  margin: 0;
  padding: 0;
  font-family: sans-serif;
}

img {
  max-width: 300px;
  width: 100%;
  border-radius: 10px;
  display: block;
  margin: 0 auto;
}

.blue {
  color: blue;
}

.quotation {
    color: gray;
    font-size:12px;
    font-style: italic;
}

.subheader {
  font-weight: bold;
  font-size: 20px;
}

.button {
      background-color: #38bdf8;
  border: none;
  color: white;
  padding: 15px 32px;
  text-align: center;
  text-decoration: none;
  display: inline-block;
  font-size: 16px;
  margin: 4px 2px;
  cursor: pointer;
}



#page1_header { 
  background-color: #0f172a;
  text-align: center;
}

#page1_content { 
  background-color: gray;
  text-align: center;
}

#history_gymnastics { 
  width: 100%;
  background-color: black;
  border: 1px solid black; 
  padding: 50px; 
}

#section_balance_beam { 
  width: 75%; 
  background-color: lightyellow; 
  border: 1px solid black; 
  padding: 50px;
  margin: 0 auto ;
}


#footer {
  background-color: #0f172a;
  color: white;
  text-align: center;
  padding: 20px;
}

.flex-container {
  display: flex;
  gap: 20px;
  justify-content: center;
  flex-wrap: wrap;
}

.box {
  background-color: white;
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.08);
  max-width: 400px;
}

@media (max-width: 600px) {
  body {
    font-size: 16px;
  }
}